<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    tools:context=".activity.QuestionAnswerActivity">

    <data>

        <variable
            name="questionAnswerViewModel"
            type="com.leandro1995.seito.viewmodel.QuestionAnswerViewModel" />
    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <include
            android:id="@+id/app_bar_blue_include"
            layout="@layout/app_bar_blue"
            android:layout_width="@dimen/dimen_0"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/dimen_0"
            android:layout_marginTop="@dimen/dimen_0"
            android:layout_marginEnd="@dimen/dimen_0"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <LinearLayout
            android:id="@+id/time_skip_linear"
            android:layout_width="@dimen/dimen_0"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/dimen_0"
            android:layout_marginTop="@dimen/dimen_0"
            android:layout_marginEnd="@dimen/dimen_0"
            android:orientation="vertical"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/app_bar_blue_include">

            <Chronometer
                android:id="@+id/time_chronometer"
                style="@style/TextBody5"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_gravity="center"
                android:gravity="center"
                android:padding="@dimen/dimen_16" />

        </LinearLayout>

        <TextView
            android:id="@+id/money_text"
            style="@style/TextBody2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/dimen_16"
            android:layout_marginTop="@dimen/dimen_0"
            android:drawableStart="@drawable/ic_coins"
            android:drawablePadding="@dimen/dimen_10"
            android:gravity="center"
            android:text="@string/available_currency_text"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/time_skip_linear"
            tools:ignore="UseCompatTextViewDrawableXml" />

        <androidx.viewpager2.widget.ViewPager2
            android:id="@+id/question_view_pager"
            android:layout_width="@dimen/dimen_0"
            android:layout_height="@dimen/dimen_0"
            android:layout_marginStart="@dimen/dimen_16"
            android:layout_marginTop="@dimen/dimen_16"
            android:layout_marginEnd="@dimen/dimen_16"
            android:layout_marginBottom="@dimen/dimen_16"
            app:layout_constraintBottom_toTopOf="@+id/button_linear"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/money_text" />

        <LinearLayout
            android:id="@+id/button_linear"
            android:layout_width="@dimen/dimen_0"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/dimen_16"
            android:layout_marginEnd="@dimen/dimen_16"
            android:layout_marginBottom="@dimen/dimen_32"
            android:orientation="horizontal"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent">

            <Button
                style="@style/ButtonCoin"
                android:layout_width="wrap_content"
                android:layout_marginEnd="@dimen/dimen_10"
                android:layout_weight="1"
                android:onClick="@{()-> questionAnswerViewModel.button.invoke(questionAnswerViewModel.COIN)}"
                android:text="@string/point_button"
                app:icon="@drawable/ic_coins"
                app:iconGravity="textStart"
                app:iconPadding="@dimen/dimen_10"
                app:iconTint="@color/yellow_FFC107" />

            <Button
                style="@style/Button"
                android:layout_width="wrap_content"
                android:layout_marginStart="@dimen/dimen_10"
                android:layout_weight="1"
                android:enabled="false"
                android:onClick="@{()-> questionAnswerViewModel.button.invoke(questionAnswerViewModel.PAGE)}"
                android:text="@string/next_button" />

        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</layout>