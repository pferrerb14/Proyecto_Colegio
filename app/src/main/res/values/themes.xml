<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.Seito" parent="Theme.Material3.Light.NoActionBar">
        <item name="android:forceDarkAllowed" tools:targetApi="q">false</item>
        <item name="colorControlActivated">@color/blue_0066FF</item>
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.App.MaterialAlertDialog</item>
        <item name="android:windowBackground">@color/white_FFFFFF</item>
        <item name="textAppearanceTitleLarge">@style/TextAppearance.App.TitleLarge</item>
    </style>

    <style name="Theme.Seito" parent="Base.Theme.Seito" />

    <!-- Theme Splash -->
    <style name="Theme.App.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/blue_0066FF</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash</item>
        <item name="windowSplashScreenAnimationDuration">@integer/icon_animation_splash</item>
        <item name="postSplashScreenTheme">@style/Theme.Seito</item>
    </style>

    <!-- Style -->
    <style name="TitleBody">
        <item name="android:fontFamily">@font/regular</item>
        <item name="android:textSize">@dimen/text_25</item>
        <item name="android:textColor">@color/white_FFFFFF</item>
    </style>

    <style name="SubTitleBody">
        <item name="android:fontFamily">@font/regular</item>
        <item name="android:textSize">@dimen/text_15</item>
        <item name="android:textColor">@color/white_FFFFFF</item>
    </style>

    <style name="TextBody">
        <item name="android:fontFamily">@font/semi_bold</item>
        <item name="android:textSize">@dimen/text_12</item>
        <item name="android:textColor">@color/black_000000</item>
    </style>

    <style name="TextBody2">
        <item name="android:fontFamily">@font/regular</item>
        <item name="android:textSize">@dimen/text_15</item>
        <item name="android:textColor">@color/black_000000</item>
    </style>

    <style name="TextBody3">
        <item name="android:fontFamily">@font/regular</item>
        <item name="android:textSize">@dimen/text_12</item>
        <item name="android:textColor">@color/black_000000</item>
    </style>

    <style name="TextBody4">
        <item name="android:fontFamily">@font/semi_bold</item>
        <item name="android:textSize">@dimen/text_20</item>
        <item name="android:textColor">@color/black_1A1A1A</item>
    </style>

    <style name="TextBody5">
        <item name="android:fontFamily">@font/semi_bold</item>
        <item name="android:textSize">@dimen/text_15</item>
        <item name="android:textColor">@color/black_1A1A1A</item>
    </style>

    <style name="TextBody6">
        <item name="android:fontFamily">@font/semi_bold</item>
        <item name="android:textSize">@dimen/text_12</item>
        <item name="android:textColor">@color/black_1A1A1A</item>
    </style>

    <style name="TextBody7">
        <item name="android:fontFamily">@font/regular</item>
        <item name="android:textSize">@dimen/text_12</item>
        <item name="android:textColor">@color/grey_1A202C</item>
    </style>

    <style name="TextBody8">
        <item name="android:fontFamily">@font/regular</item>
        <item name="android:textSize">@dimen/text_12</item>
        <item name="android:textColor">@color/grey_98A0AE</item>
    </style>

    <style name="LinkBody">
        <item name="android:fontFamily">@font/regular</item>
        <item name="android:textSize">@dimen/text_15</item>
        <item name="android:textColor">@color/blue_0066FF</item>
    </style>

    <!-- Component -->
    <style name="EditText">
        <item name="android:textSize">@dimen/dimen_15</item>
        <item name="android:paddingStart">@dimen/dimen_10</item>
        <item name="android:layout_height">@dimen/dimen_35</item>
        <item name="android:background">@drawable/background_edit_text</item>
        <item name="android:fontFamily">@font/regular</item>
        <item name="android:textColor">@color/black_000000</item>
    </style>

    <style name="Button">
        <item name="android:layout_height">@dimen/dimen_50</item>
        <item name="android:backgroundTint">@color/blue_0066FF</item>
        <item name="android:fontFamily">@font/regular</item>
        <item name="android:textSize">@dimen/text_15</item>
        <item name="cornerRadius">@dimen/dimen_10</item>
        <item name="android:textColor">@color/white_FFFFFF</item>
    </style>

    <style name="LoadingComponentTextBody">
        <item name="android:fontFamily">@font/semi_bold</item>
        <item name="android:textSize">@dimen/text_25</item>
        <item name="android:textColor">@color/blue_0066FF</item>
    </style>

    <style name="TextAppearance.App.TitleLarge" parent="TextAppearance.Material3.TitleLarge">
        <item name="fontFamily">@font/regular</item>
        <item name="android:fontFamily">@font/regular</item>
    </style>

    <style name="BottomNavigationTextInactive" parent="TextAppearance.Material3.LabelLarge">
        <item name="android:fontFamily">@font/regular</item>
    </style>

    <style name="BottomNavigationTextActive" parent="TextAppearance.Material3.LabelLarge">
        <item name="android:fontFamily">@font/semi_bold</item>
    </style>

    <style name="BottomNavigationIndicator" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:color">@color/blue_3383FB</item>
    </style>

    <style name="ButtonGoOut" parent="Button">
        <item name="android:backgroundTint">@color/red_F92C36</item>
    </style>

    <!-- Dialog -->
    <style name="ThemeOverlay.App.MaterialAlertDialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="colorPrimary">@color/blue_0066FF</item>
        <item name="android:background">@color/white_FFFFFF</item>
        <item name="colorOnSurface">@color/blue_0066FF</item>
    </style>

</resources>